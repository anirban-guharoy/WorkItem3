PORT=3002

# Azure AI Foundry model used to summarize Backstage-provided pod activity.
AZURE_FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com/anthropic
AZURE_FOUNDRY_API_KEY=
# MODEL_CONFIG_FILE=agents/wpf-sre-agent/config/models.json

# Remote Backstage base URL and bearer token. Configure route paths to match your
# installed Kubernetes/Azure Insights plugins or custom Backstage API.
BACKSTAGE_BASE_URL=https://backstage.example.com
BACKSTAGE_API_TOKEN=
BACKSTAGE_AZURE_HEALTH_PATH=
BACKSTAGE_PODS_PATH=
BACKSTAGE_POD_ACTIVITY_PATH=
BACKSTAGE_RESTART_ACTION_PATH=
BACKSTAGE_RESTART_ACTION_METHOD=POST
# JSON request body; {namespace} and {pod} are substituted with URL-escaped values.
BACKSTAGE_RESTART_ACTION_BODY={"namespace":"{namespace}","pod":"{pod}"}
BACKSTAGE_REQUEST_TIMEOUT_MS=15000

# Remote MCP server "common-mcp-server" (streamable HTTP), used to retrieve
# relevant runbooks, known incidents, and operational guidance for pod summaries.
MCP_SERVER_URL=https://mcp.example.com/mcp
MCP_SERVER_TOKEN=
# Local feedback history path; production uses a persistent volume.
WPF_SRE_LEARNING_STORE_PATH=./data/learning.json

# Entra API app registration: delegated scopes Agent.Read and Agent.Restart,
# app role DevOps, and the corresponding audience/client ID.
ENTRA_TENANT_ID=
ENTRA_API_AUDIENCE=
ENTRA_READ_SCOPE=Agent.Read
ENTRA_RESTART_SCOPE=Agent.Restart
ENTRA_DEVOPS_ROLE=DevOps
DASHBOARD_ORIGIN=http://localhost:8080

# Azure Bot registration for Microsoft Teams.
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
# Restrict the bot to the configured Teams team and channel IDs.
WPF_DEVOPS_TEAM_IDS=
WPF_DEVOPS_CHANNEL_IDS=

# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=wpf-sre-agent
