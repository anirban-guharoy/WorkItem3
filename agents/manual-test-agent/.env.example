PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Shared secret; configure the JIRA webhook URL as  /webhook/jira?secret=<value>
WEBHOOK_SECRET=change-me

# Azure AI Foundry Claude (Anthropic-compatible endpoint). Model/deployment name is in config/models.json
AZURE_FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com/anthropic
AZURE_FOUNDRY_API_KEY=
# MODEL_CONFIG_FILE=config/models.json

# Entra ID API app registration settings
ENTRA_TENANT_ID=
ENTRA_API_AUDIENCE=
ENTRA_READ_SCOPE=Agent.Read
ENTRA_REVIEW_SCOPE=Agent.Review
ENTRA_DEVOPS_ROLE=DevOps
ENTRA_TESTER_ROLE=Tester
DASHBOARD_ORIGIN=http://localhost:8080

# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=manual-test-agent

# JIRA (optional but recommended: fetches the latest story and posts a review link back)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# Custom field id holding acceptance criteria, e.g. customfield_10040 (optional;
# otherwise criteria are taken from the description)
JIRA_AC_FIELD=

# Remote MCP server "common-mcp-server" (Confluence + SharePoint), streamable HTTP
MCP_SERVER_URL=https://mcp.example.com/mcp
# Optional bearer token
MCP_SERVER_TOKEN=

# Where reviews are stored (container default: /data)
DATA_DIR=./data

# Xray Cloud (approved test cases are created here and added to the test cycle)
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=
XRAY_BASE_URL=https://xray.cloud.getxray.app
# Default Test Execution (test cycle) name; the reviewer can override it on the review page
XRAY_TEST_CYCLE_NAME=Manual Tester - Sprint Regression
