PORT=3001
AZURE_FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com/anthropic
AZURE_FOUNDRY_API_KEY=
# This file selects a model distinct from the generator. Deploy the corresponding Foundry model.
# MODEL_CONFIG_FILE=agents/manual-test-review-agent/config/models.json

# Remote MCP server "common-mcp-server" (Confluence + SharePoint), streamable HTTP
MCP_SERVER_URL=https://mcp.example.com/mcp
# Optional bearer token
MCP_SERVER_TOKEN=

# Entra ID API app registration settings
ENTRA_TENANT_ID=
ENTRA_API_AUDIENCE=
ENTRA_READ_SCOPE=Agent.Read
ENTRA_INVOKE_SCOPE=Agent.Invoke
ENTRA_DEVOPS_ROLE=DevOps
DASHBOARD_ORIGIN=http://localhost:8080

# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=manual-test-review-agent

# Xray Cloud integration (EU/AU tenants may set their regional XRAY_BASE_URL)
XRAY_BASE_URL=https://xray.cloud.getxray.app
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=
XRAY_TEST_CYCLE_NAME=Manual Test Review - Regression
