# Copy to .env for local development. Never commit real values.
APP_ENV=local
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# --- Local mode (npm run dev:local): PGlite + in-memory queue + mock MCP + fake model + dev auth ---
AUTH_MODE=dev
MCP_ADAPTER=mock
MODEL_PROVIDER=fake
QUEUE_TRANSPORT=memory
CHECKPOINTER=memory
DATABASE_URL=pglite://memory
AUTO_MIGRATE=true
MCP_ALLOW_WRITES=true

# --- Local Postgres (docker compose up -d postgres) instead of PGlite ---
# DATABASE_URL=postgres://agent:agent_local_only@127.0.0.1:5432/manual_test_agent
# CHECKPOINTER=postgres

# --- Staging/production (set via Helm values + Key Vault, not this file) ---
# AUTH_MODE=entra
# ENTRA_TENANT_ID=<tenant-guid>
# ENTRA_AUDIENCE=api://<app-id-uri>
# MCP_ADAPTER=remote
# MCP_SERVER_URL=https://<private-mcp-host>/mcp
# MCP_AUTH_MODE=entra|bearer|none
# MCP_TOOL_MAP_JSON={...}        # see docs/model-configuration.md
# MODEL_PROVIDER=foundry
# FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com/anthropic
# FOUNDRY_DEPLOYMENT=<deployment-name>
# QUEUE_TRANSPORT=servicebus
# SERVICEBUS_NAMESPACE=<namespace>.servicebus.windows.net
# PROJECTS_JSON={"PROJ":{"members":["<entra-group-oid>"],"confluenceSpaces":["PROJ"],"figmaFileKeys":[],"publishDestination":"<destination>"}}
