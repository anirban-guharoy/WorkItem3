{
  "name": "@workitem3/wpf-sre-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/api/app.js",
  "scripts": {
    "start": "node src/api/main.js",
    "dev": "node --watch src/api/main.js",
    "check": "node --check src/api/main.js && node --check src/api/app.js && node --check src/api/teams-adapter.js && node --check src/graph/summary.js && node --check src/config/index.js && node --check src/services/backstage.js && node --check src/repositories/learning-store.js",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js tests/e2e/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "node --test tests/e2e/*.test.js"
  },
  "dependencies": {
    "@langchain/core": "^1.2.17",
    "@workitem3/agent-common": "1.0.0",
    "@workitem3/entra-auth": "1.0.0",
    "@workitem3/langchain-runtime": "1.0.0",
    "@microsoft/agents-hosting": "^1.9.1",
    "@microsoft/agents-hosting-express": "^1.9.1",
    "cors": "^2.8.5",
    "dotenv": "^18.0.7",
    "express": "^5.3.0"
  }
}
