  },
  "dependencies": {
    "@azure/msal-browser": "^4.27.0",
    "express": "^5.3.0",
    "jose": "^6.1.0",
    "langsmith": "^0.10.11"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
