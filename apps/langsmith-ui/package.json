{
  "name": "@workitem3/langsmith-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build": "esbuild src/client.js --bundle --minify --outfile=public/app.js",
