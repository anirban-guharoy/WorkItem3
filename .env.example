PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Shared secret; configure the JIRA webhook URL as  /webhook/jira?secret=<value>
WEBHOOK_SECRET=change-me

# LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# JIRA (optional but recommended: fetches the latest story and posts a review link back)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# Custom field id holding acceptance criteria, e.g. customfield_10040 (optional;
# otherwise criteria are taken from the description)
JIRA_AC_FIELD=

# Remote MCP servers (Confluence + SharePoint). JSON map of name -> connection.
MCP_SERVERS={"confluence":{"transport":"http","url":"https://mcp.example.com/confluence/mcp","headers":{"Authorization":"Bearer <token>"}},"sharepoint":{"transport":"http","url":"https://mcp.example.com/sharepoint/mcp","headers":{"Authorization":"Bearer <token>"}}}
