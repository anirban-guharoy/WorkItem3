PORT=8080

# Entra ID tenant and this UI/API app registration. Expose delegated scope Dashboard.Read.
ENTRA_TENANT_ID=
ENTRA_UI_CLIENT_ID=
ENTRA_UI_API_AUDIENCE=
ENTRA_DASHBOARD_SCOPE=Dashboard.Read
ENTRA_DEVOPS_ROLE=DevOps
ENTRA_TESTER_ROLE=Tester

# External URLs must be reachable from the signed-in user's browser.
MANUAL_TEST_AGENT_URL=https://manual-tester.example.com
MANUAL_TEST_AGENT_CLIENT_ID=
MANUAL_TEST_AGENT_SCOPE=Agent.Read
MANUAL_TEST_AGENT_REVIEW_SCOPE=Agent.Review
MANUAL_TEST_REVIEW_AGENT_URL=https://manual-test-reviewer.example.com
MANUAL_TEST_REVIEW_AGENT_CLIENT_ID=
MANUAL_TEST_REVIEW_AGENT_SCOPE=Agent.Read
WPF_SRE_AGENT_URL=https://wpf-sre-agent.example.com
WPF_SRE_AGENT_CLIENT_ID=
WPF_SRE_AGENT_SCOPE=Agent.Read

# Server-side LangSmith credentials; never sent to the browser.
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_MANUAL_TEST_PROJECT=manual-test-agent
LANGSMITH_REVIEW_AGENT_PROJECT=manual-test-review-agent
LANGSMITH_WPF_SRE_PROJECT=wpf-sre-agent
